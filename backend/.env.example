CAMPUSLINK_SECRET_KEY=replace-with-a-long-random-secret
# MySQL option: mysql+pymysql://campuslink:change-me@localhost:3306/campuslink?charset=utf8mb4
# If DATABASE_URL is unset, a local SQLite database is created for a quick demo.
DATABASE_URL=mysql+pymysql://campuslink:change-me@localhost:3306/campuslink?charset=utf8mb4
MAX_UPLOAD_MB=10
UPLOAD_FOLDER=uploads
# Optional scanned-resume OCR: install Tesseract OCR separately, then point this
# to its tessdata directory (Windows default: C:/Program Files/Tesseract-OCR/tessdata).
TESSDATA_PREFIX=
RESUME_OCR_LANGUAGE=eng
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gmail SMTP is used for Company password-reset OTP delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail@gmail.com
SMTP_FROM_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=your_google_app_password
# Quick Quiz uses OpenRouter separately from the Groq-powered placement assistant.
OPENROUTER_API_KEY=
# OpenRouter currently lists this model without a :free variant. Override if your provider offers one.
QUIZ_MODEL=deepseek/deepseek-v4.1-flash
APP_TIMEZONE=Asia/Kolkata
